<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DotNetJqPackageVersion Condition="'$(DotNetJqPackageVersion)' == ''">0.0.0-isolation</DotNetJqPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNetJq.Library" Version="$(DotNetJqPackageVersion)" />
  </ItemGroup>
</Project>
